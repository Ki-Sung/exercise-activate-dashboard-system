SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # service_role. 서버 사이드 전용!
GARMIN_TOKEN_B64=eyJvYXV0aDFf...               # bootstrap_token.py 가 출력한 값

# ---- API 서버 ----
DASHBOARD_API_KEY=                              # openssl rand -hex 32
ALLOWED_ORIGINS=https://exercise-activate-dashboard-system.vercel.app,http://localhost:3000
INTERNAL_API_BASE=https://exercise-activate-dashboard-system.vercel.app/api/py

# ---- 프론트(웹) ----
NEXT_PUBLIC_API_BASE=/api/py
DASHBOARD_API_KEY_SERVER=                       # DASHBOARD_API_KEY 와 동일 (서버 컴포넌트 전용)
