# ---- 배치 / API 공통 (절대 커밋 금지) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # service_role. 서버 사이드 전용!
GARMIN_TOKEN_B64=eyJvYXV0aDFf...               # bootstrap_token.py 가 출력한 값

# ---- API 서버 ----
DASHBOARD_API_KEY=                              # openssl rand -hex 32
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ---- 프론트(웹) ----
NEXT_PUBLIC_API_BASE=/api/py
DASHBOARD_API_KEY_SERVER=                       # 서버 컴포넌트에서만 사용
